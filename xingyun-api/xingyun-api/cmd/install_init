#!/bin/bash

### 行云API 安装前回调 — 清理残留进程与端口

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/xingyun-api}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/xingyun-api/var}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [install_init] $1"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== install_init start ==="

pkill -9 -f "bin/JoyCode2Api" 2>/dev/null || true
_wait=0
while [ ${_wait} -lt 10 ]; do
    if ! pgrep -f "bin/JoyCode2Api" >/dev/null 2>&1; then
        break
    fi
    sleep 1
    _wait=$((_wait + 1))
done
log_msg "进程清理完成 (等待 ${_wait}s)"

for PORT in 34891; do
    PID=$(ss -tlnp 2>/dev/null | grep ":${PORT} " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
    if [ -n "$PID" ]; then
        CMDLINE=$(ps -p "$PID" -o cmd= 2>/dev/null | grep -iE 'JoyCode2Api' || true)
        if [ -n "$CMDLINE" ]; then
            log_msg "端口 ${PORT} 被残留进程 pid=${PID} 占用，清理"
            kill -9 "$PID" 2>/dev/null || true
        fi
    fi
done
sleep 1
rm -f "${TRIM_PKGVAR}/app.pid" 2>/dev/null || true
log_msg "=== install_init end ==="
exit 0
