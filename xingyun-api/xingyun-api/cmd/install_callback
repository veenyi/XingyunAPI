#!/bin/bash

### 行云API 安装后回调 — 目录准备、密码持久化、权限修复

set -e

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/xingyun-api}"
TRIM_PKGHOME="${TRIM_PKGHOME:-/var/apps/xingyun-api/home}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/xingyun-api/var}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [install] $1"
    echo "$msg"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

toast_err() {
    echo "$*" > "$TRIM_TEMP_LOGFILE"
}

trap 'toast_err "脚本出错(L${LINENO}): $(tail -3 "${LOG_FILE}" 2>/dev/null)"' ERR

log_msg "=== install_callback start ==="

gen_password() {
    local p=""
    p=$(head -c 64 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'A-Za-z0-9' | head -c 16)
    [ -z "$p" ] && p="Xingyun$(date +%s)X9a"
    echo "$p"
}

# 1) 二进制权限
chmod 755 "${TRIM_APPDEST}/bin/JoyCode2Api" 2>/dev/null || true
log_msg "binary chmod done"

# 2) 数据目录
mkdir -p "${TRIM_PKGVAR}/logs" "${TRIM_PKGHOME}"
log_msg "data dirs created"

# 3) 版本记录
echo "$(cat "${TRIM_APPDEST}/manifest" 2>/dev/null | grep '^version' | awk '{print $3}')" > "${TRIM_PKGVAR}/app_version" 2>/dev/null || true

# 4) 初始密码（安装向导设置，留空自动生成）
ENV_FILE="${TRIM_PKGVAR}/.env"
touch "${ENV_FILE}" 2>/dev/null || true
chmod 600 "${ENV_FILE}" 2>/dev/null || true

PASS="${wizard_password:-}"
[ -z "$PASS" ] && PASS=$(gen_password)

if ! grep -q '^PASSWORD=' "${ENV_FILE}" 2>/dev/null; then
    echo "PASSWORD=${PASS}" >> "${ENV_FILE}"
    log_msg "PASSWORD written to .env (wizard=${wizard_password:+set}/auto)"
else
    PASS=$(grep '^PASSWORD=' "${ENV_FILE}" | tail -1 | cut -d= -f2-)
    log_msg "PASSWORD already exists, keeping existing"
fi

# 凭据文件（首次写入）
if [ ! -f "${TRIM_PKGVAR}/credentials.txt" ]; then
    cat > "${TRIM_PKGVAR}/credentials.txt" <<EOF

[行云API 面板] http://<NAS-IP>:34891
面板密码: ${PASS}  (登录后请及时修改)
EOF
    chmod 600 "${TRIM_PKGVAR}/credentials.txt" 2>/dev/null || true
fi

# 安装完成弹窗
cat > "${TRIM_TEMP_LOGFILE}" <<EOF
行云API 安装完成！

【面板地址】http://<NAS-IP>:34891
  面板密码: ${PASS}

登录后请及时修改密码。
（凭据同时保存在 @appdata/xingyun-api/credentials.txt）
EOF
log_msg "credentials toast written"

# 5) 权限修复
if [ -n "${TRIM_USERNAME}" ]; then
    chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${TRIM_PKGVAR}" 2>>"${LOG_FILE}" || true
    chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${TRIM_PKGHOME}" 2>>"${LOG_FILE}" || true
fi

trap - ERR
log_msg "install_callback finished successfully."
exit 0
